        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Customer\nparticipant \&quot;CatalogPage (React UI)\&quot; as UI\nparticipant \&quot;ProductController (Django)\&quot; as Controller\ndatabase \&quot;Database (PostgreSQL)\&quot; as DB\n\nCustomer -&gt; UI: clickOnViewAllProducts()\nactivate UI\nUI -&gt; Controller: getAvailableProducts()\nactivate Controller\nController -&gt; DB: SELECT * FROM products WHERE is_available = True\nactivate DB\nDB --&gt; Controller: return productList\ndeactivate DB\nController --&gt; UI: return HTTP 200 OK (productsJSON)\ndeactivate Controller\nUI --&gt; Customer: renderProductGrid(products)\ndeactivate UI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Bs2FOghuTQHc7lv5bqNY-16">
