        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Customer\nparticipant \&quot;ProductCard (UI)\&quot; as Card\nparticipant \&quot;ProductDetailPage (UI)\&quot; as DetailUI\nparticipant \&quot;ProductController\&quot; as Controller\ndatabase \&quot;Database\&quot; as DB\n\nCustomer -&gt; Card: clickOnProduct(productId)\nactivate Card\nCard -&gt; DetailUI: navigateToProductPage(productId)\ndeactivate Card\n\nactivate DetailUI\nDetailUI -&gt; Controller: getProductDetails(productId)\nactivate Controller\nController -&gt; DB: SELECT * FROM products WHERE id = productId\nactivate DB\nDB --&gt; Controller: return productData (details, images, sizes, colors)\ndeactivate DB\n\nController --&gt; DetailUI: return HTTP 200 OK (detailsJSON)\ndeactivate Controller\nDetailUI --&gt; Customer: renderProductView(data)\ndeactivate DetailUI\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Bs2FOghuTQHc7lv5bqNY-131">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
